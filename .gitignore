# Rust build artifacts
/target/

# Claude Code local state (agent worktrees, etc.)
.claude/

# Stray ts-rs output: the canonical bindings live in /bindings (generated by
# `cargo xtask gen`). A bare `cargo test` (without xtask's TS_RS_EXPORT_DIR) would
# drop a copy under each crate's default dir — ignore those so they never get
# committed by accident.
/crates/*/bindings/

# Local reverse-engineering / analysis artifacts (not part of the project)
pyghidra_mcp_projects/

# Frontend monorepo (frontend/)
frontend/node_modules/
frontend/**/node_modules/
frontend/**/dist/
frontend/**/build/
frontend/**/.svelte-kit/
frontend/**/.vite/
frontend/**/*.tsbuildinfo
frontend/.eslintcache
