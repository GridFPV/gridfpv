# Settings for the Grid server. Copy to /etc/gridfpv-server.env and keep it private:
#
#   install -m 600 gridfpv-server.env /etc/gridfpv-server.env
#
# Then: systemctl restart gridfpv-server

# The address people open. Signing in needs it.
GRIDFPV_SERVER_PUBLIC_URL=https://grid.example.org

# Sign in with Discord. Leave empty to leave it off.
GRIDFPV_SERVER_DISCORD_CLIENT_ID=
GRIDFPV_SERVER_DISCORD_CLIENT_SECRET=

# Sign in with Google. Leave empty to leave it off.
GRIDFPV_SERVER_GOOGLE_CLIENT_ID=
GRIDFPV_SERVER_GOOGLE_CLIENT_SECRET=

# Sign in with a service of your own that speaks OpenID Connect. Leave empty to leave it
# off. All six are needed. The addresses must start with https://
GRIDFPV_SERVER_OIDC_NAME=
GRIDFPV_SERVER_OIDC_AUTHORIZE_URL=
GRIDFPV_SERVER_OIDC_TOKEN_URL=
GRIDFPV_SERVER_OIDC_USERINFO_URL=
GRIDFPV_SERVER_OIDC_CLIENT_ID=
GRIDFPV_SERVER_OIDC_CLIENT_SECRET=

# Email, to confirm an address and to send a link for a forgotten password. Leave the host
# empty to leave it off. Your email provider gives you these: look for "SMTP" in its help.
# The port is 587 unless you set one. For port 465, set GRIDFPV_SERVER_SMTP_TLS=tls
GRIDFPV_SERVER_SMTP_HOST=
GRIDFPV_SERVER_SMTP_USER=
GRIDFPV_SERVER_SMTP_PASSWORD=
GRIDFPV_SERVER_SMTP_FROM=Grid <grid@example.org>
