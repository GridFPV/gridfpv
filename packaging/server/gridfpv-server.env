# Settings for the Grid server. Copy to /etc/gridfpv-server.env and keep it private:
#
#   install -m 600 gridfpv-server.env /etc/gridfpv-server.env
#
# Then: systemctl restart gridfpv-server

# The address people open. Signing in needs it.
GRIDFPV_SERVER_PUBLIC_URL=https://grid.example.org

# Sign in with Discord. Leave empty to leave it off.
GRIDFPV_SERVER_DISCORD_CLIENT_ID=
GRIDFPV_SERVER_DISCORD_CLIENT_SECRET=

# Sign in with Google. Leave empty to leave it off.
GRIDFPV_SERVER_GOOGLE_CLIENT_ID=
GRIDFPV_SERVER_GOOGLE_CLIENT_SECRET=
